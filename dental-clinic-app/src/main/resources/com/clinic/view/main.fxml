<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.clinic.controller.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" minWidth="230">
            <padding>
                <Insets top="24" right="14" bottom="24" left="14"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-box">
                <FontIcon iconLiteral="fth-activity" iconSize="22" styleClass="brand-icon"/>
                <Label text="OdontoSalud" styleClass="brand-label"/>
            </HBox>

            <Separator styleClass="sidebar-separator">
                <VBox.margin>
                    <Insets top="18" bottom="10"/>
                </VBox.margin>
            </Separator>

            <VBox spacing="4" fx:id="navBox">
                <Button fx:id="navPatientRegister" text="Registrar paciente" onAction="#showPatientRegister"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-user-plus"/></graphic>
                </Button>
                <Button fx:id="navHistorySearch" text="Historia clínica" onAction="#showHistorySearch"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                </Button>
                <Button fx:id="navProcedures" text="Procedimientos" onAction="#showProcedures"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-clipboard"/></graphic>
                </Button>
                <Button fx:id="navReferral" text="Solicitud especialista" onAction="#showReferral"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-share-2"/></graphic>
                </Button>
                <Button fx:id="navAppointments" text="Citas" onAction="#showAppointments"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-calendar"/></graphic>
                </Button>
                <Button fx:id="navPayments" text="Cobros" onAction="#showPayments"
                        styleClass="nav-button">
                    <graphic><FontIcon iconLiteral="fth-dollar-sign"/></graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="sidebar-separator">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </Separator>

            <Label fx:id="userLabel" text="Usuario" styleClass="user-label"/>
            <Button text="Cerrar sesión" onAction="#handleLogout" styleClass="nav-button, logout-button">
                <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
